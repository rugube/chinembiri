                  <thead><tr><th>Name</th><th>Category</th><th>Purchase Value</th><th>Status</th></tr></thead>
                  <tbody>
                    <% if (safeFinance?.assets?.length) { safeFinance.assets.forEach(a => { %>
                      <tr>
                        <td class="td-strong"><%= a.name %></td>
                        <td><span class="apro-pill"><%= a.category %></span></td>
                        <td>$<%= Number(a.purchase_value || 0).toFixed(2) %></td>
                        <td><span class="apro-badge apro-badge-ok"><%= a.status || "ACTIVE" %></span></td>
                      </tr>
                    <% }) } else { %>
                      <tr><td colspan="4" class="apro-center-muted">No assets recorded.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </section>

        <!-- ================= SYSTEM ================= -->
        <section id="system" class="page-content">

          <div class="apro-head">
            <div>
              <h2 class="apro-title">⚙️ System Settings</h2>
              <p class="apro-subtitle">Manage configuration, school details and system health.</p>
            </div>
            <span class="apro-chip">Admin</span>
          </div>

          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">Configuration</h3>
              <span class="apro-chip">Tools</span>
            </div>

            <div class="apro-actions">
              <button id="schoolSettingsBtn" class="apro-btn apro-btn-primary" type="button">🛠️ School Settings</button>
              <button id="backupBtn" class="apro-btn" type="button">🔄 Backup & Restore</button>
              <button id="maintenanceBtn" class="apro-btn apro-btn-danger" type="button">🚧 System Maintenance</button>
            </div>
          </div>

          <div class="apro-grid-2" style="margin-top:14px;">

            <div class="apro-card">
              <div class="apro-card-head">
                <h3 class="apro-card-title">School Information</h3>
                <span class="apro-chip">Profile</span>
              </div>

              <div id="schoolInfo" class="apro-panel">
                <!-- Dynamically loaded -->
              </div>

              <div class="apro-actions" style="margin-top:10px;">
                <button class="apro-btn apro-btn-primary" type="button" onclick="openEditSchoolInfo()">✏️ Edit School Info</button>
              </div>
            </div>

            <div class="apro-card">
              <div class="apro-card-head">
                <h3 class="apro-card-title">System Status</h3>
