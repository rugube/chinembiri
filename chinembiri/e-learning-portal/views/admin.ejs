              </div>

              <div id="systemStatus" class="apro-panel">
                <!-- Dynamically loaded -->
              </div>

              <div class="apro-actions" style="margin-top:10px;">
                <button class="apro-btn" type="button" onclick="runMaintenance()">🛠 Run Maintenance</button>
              </div>
            </div>

          </div>
        </section>

      </div>
    </main>
  </div>
</div>

