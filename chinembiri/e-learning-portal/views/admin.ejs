<%
  // ----------------------------
  // SAFE FALLBACKS (prevents EJS crashes)
  // ----------------------------
  const safeUser =
    (typeof user !== "undefined" && user)
      ? user
      : { first_name: "Admin", last_name: "", unique_id: "-" };

  const safeStats =
    (typeof stats !== "undefined" && stats)
      ? stats
      : { students: 0, teachers: 0, classes: 0, revenue: 0 };

  const safeActivities =
    (typeof activities !== "undefined" && activities)
      ? activities
      : [];

  const safeStudents =
    (typeof students !== "undefined" && students)
      ? students
      : [];

  const safeTeachersList =
    (typeof teachersList !== "undefined" && teachersList)
      ? teachersList
      : [];

  const safeClassesList =
    (typeof classesList !== "undefined" && classesList)
      ? classesList
      : [];

  const safeClasses = safeClassesList;

  const safeSubjects =
    (typeof subjects !== "undefined" && subjects)
      ? subjects
      : [];

  const safeFeeStructure =
    (typeof feeStructure !== "undefined" && feeStructure)
      ? feeStructure
      : [];

  const safeFinance =
    (typeof finance !== "undefined" && finance)
      ? finance
      : {};
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Chinembiri Primary | Admin Portal</title>
  <link rel="apple-touch-icon" href="/uploads/images/logo.png">
  <link rel="icon" href="/uploads/images/favicon.ico" type="image/x-icon">

  <!-- Bootstrap (for offcanvas + grid + responsive helpers) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Your existing styles -->
  <link rel="stylesheet" href="/style.css?v=2" />

  <style>
    :root{ font-size: clamp(14px, 1.05vw + 11px, 18px); }
    body{ -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }

    /* Topbar (same vibe as Teacher portal) */
    .topbar{
      background: rgba(13, 27, 42, 0.92);
      backdrop-filter: blur(10px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.15);
      border-bottom: 1px solid rgba(255,255,255,0.10);
      color:#fff;
      z-index: 1030; /* same as bootstrap sticky top */
    }
    .topbar a{ color:#fff; text-decoration:none; }
    .topbar a:hover{ text-decoration: underline; }

    /* Offcanvas look */
    .portal-offcanvas{
      width: min(340px, 90vw);
      background:#0d1b2a;
      color:#fff;
    }
    .portal-offcanvas .offcanvas-title{ color:#fff; }

    /* Navigation buttons style (works for both desktop + mobile) */
    .portal-nav .btn{
      text-align:left;
      border-radius:14px;
      padding:.75rem .85rem;
      color:#fff;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.10);
    }
    .portal-nav .btn:hover{
      background: rgba(255,255,255,0.10);
      border-color: rgba(76,201,240,0.35);
    }
    .portal-nav .btn.active{
      background: rgba(76,201,240,0.16);
      border-color: rgba(76,201,240,0.45);
    }
    .nav-ico{ width: 1.6rem; display:inline-block; }

    /* Desktop sidebar sticky */
    @media (min-width: 992px){
      .portal-sidebar{
        position: sticky;
        top: 76px;
        height: calc(100vh - 76px);
        overflow:auto;
        padding-bottom:18px;
      }
    }

    /* Responsive tables */
    .apro-table-wrap{
      overflow-x:auto;
      -webkit-overflow-scrolling: touch;
      border-radius:16px;
    }

    /* prevent content width blowouts on large tables */
    .content-area{ min-width:0; }

    /* helpers */
    .only-desktop{ display:none; }
    @media (min-width: 992px){ .only-desktop{ display:block; } }
    .only-mobile{ display:block; }
    @media (min-width: 992px){ .only-mobile{ display:none; } }

    .page-shell{ padding-top: 18px; padding-bottom: 28px; }

    /* optional: give tables a minimum width like your teacher layout */
    table{ min-width: 760px; }
  </style>
</head>

<body>

<!-- =========================
     TOPBAR (replaces old header)
========================= -->
<header class="topbar sticky-top">
  <div class="container-fluid px-3 px-lg-4 py-2">
    <div class="d-flex align-items-center justify-content-between gap-2">

      <!-- Left: title + mobile menu -->
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-light only-mobile"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#sidebarOffcanvasAdmin"
                aria-controls="sidebarOffcanvasAdmin"
                aria-label="Open menu">
          ☰
        </button>

        <div class="lh-sm">
          <div class="fw-bold">👨‍💼 Admin Portal - Chinembiri Primary</div>
          <small class="opacity-75">Welcome, <%= safeUser.first_name %> <%= safeUser.last_name %></small>
        </div>
      </div>

      <!-- Right: ID + logout -->
      <div class="text-end lh-sm">
        <small class="opacity-75 d-block">Admin ID</small>
        <div class="fw-bold"><%= safeUser.unique_id %></div>
        <a class="d-inline-block mt-1" href="/logout">🔒 Logout</a>
      </div>

    </div>
  </div>
</header>

<!-- =========================
     LAYOUT
========================= -->
<div class="container-fluid px-0">
  <div class="row g-0">

    <!-- =========================
         DESKTOP SIDEBAR
    ========================= -->
    <aside class="col-lg-3 col-xl-2 d-none d-lg-block border-end" style="background:#0d1b2a;">
      <div class="portal-sidebar p-3">

        <!-- Brand / context header -->
        <div class="mb-3">
          <div class="d-flex align-items-center gap-2" style="color:#fff;">
            <span style="font-size:1.4rem;">🏫</span>
            <div>
              <div class="fw-bold">Admin Portal</div>
              <small class="opacity-75">School Management</small>
            </div>
          </div>
        </div>

        <nav class="portal-nav d-grid gap-2" aria-label="Admin navigation">
          <button type="button" class="btn nav-item active" onclick="setActiveAdmin(this); showPage('dashboard')">
            <span class="nav-ico">🏠</span><span>Dashboard</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('students')">
            <span class="nav-ico">👥</span><span>Students</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('teachers')">
            <span class="nav-ico">👨‍🏫</span><span>Teachers</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('classes')">
            <span class="nav-ico">📚</span><span>Classes</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('subjects')">
            <span class="nav-ico">📘</span><span>Subjects</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('fees')">
            <span class="nav-ico">💰</span><span>Fees</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('library')">
            <span class="nav-ico">🏛️</span><span>Library</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('notices')">
            <span class="nav-ico">📢</span><span>Notices</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('reports')">
            <span class="nav-ico">📈</span><span>Reports</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('finance')">
            <span class="nav-ico">💼</span><span>Finance</span>
          </button>

          <button type="button" class="btn nav-item" onclick="setActiveAdmin(this); showPage('system')">
            <span class="nav-ico">⚙️</span><span>System</span>
          </button>
        </nav>
      </div>
    </aside>

    <!-- =========================
         MAIN CONTENT
    ========================= -->
    <main class="col-12 col-lg-9 col-xl-10 content-area">
      <div class="container page-shell">

        <!-- ================= DASHBOARD ================= -->
        <section id="dashboard" class="page-content active">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">📊 School Administration</h2>
              <p class="apro-subtitle">Overview of students, staff, classes and revenue.</p>
            </div>
            <span class="apro-chip">Today: <%= new Date().toDateString() %></span>
          </div>

          <div class="apro-stats">
            <div class="apro-stat">
              <div class="apro-stat-top"><span class="apro-ico">👥</span><span class="apro-label">Total Students</span></div>
              <div class="apro-value"><%= safeStats.students %></div>
            </div>

            <div class="apro-stat">
              <div class="apro-stat-top"><span class="apro-ico">👨‍🏫</span><span class="apro-label">Total Teachers</span></div>
              <div class="apro-value"><%= safeStats.teachers %></div>
            </div>

            <div class="apro-stat">
              <div class="apro-stat-top"><span class="apro-ico">🏫</span><span class="apro-label">Active Classes</span></div>
              <div class="apro-value"><%= safeStats.classes %></div>
            </div>

            <div class="apro-stat">
              <div class="apro-stat-top"><span class="apro-ico">💵</span><span class="apro-label">Monthly Revenue</span></div>
              <div class="apro-value">$<%= safeStats.revenue %></div>
            </div>
          </div>

          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">⚡ Quick Actions</h3>
            </div>

            <div class="apro-actions">
              <button class="apro-btn apro-btn-primary" onclick="openAddStudent()">➕ Add Student</button>
              <button class="apro-btn apro-btn-primary" onclick="openAddTeacher()">➕ Add Teacher</button>
              <button class="apro-btn" onclick="openAddNotice?.()">📢 Publish Notice</button>
              <button class="apro-btn" onclick="openFeeReport?.()">📄 Generate Report</button>
              <button class="apro-btn" onclick="openSettings?.()">⚙️ System Settings</button>
            </div>
          </div>

          <div class="apro-card" style="margin-top:14px;">
            <div class="apro-card-head">
              <h3 class="apro-card-title">🕘 Recent Activity</h3>
              <span class="apro-chip"><%= safeActivities?.length ?? 0 %> events</span>
            </div>

            <% if (!safeActivities || safeActivities.length === 0) { %>
              <p class="apro-center-muted">No recent activity.</p>
            <% } else { %>
              <div class="apro-list">
                <% safeActivities.forEach(a => { %>
                  <div class="apro-item">
                    <p class="apro-item-desc"><%= a.message %></p>
                    <small class="apro-meta"><%= new Date(a.created_at).toDateString() %></small>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ================= STUDENTS ================= -->
        <section id="students" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">👥 Student Directory</h2>
              <p class="apro-subtitle">Search, filter, add and manage student records.</p>
            </div>
            <span class="apro-chip"><%= safeStudents?.length ?? 0 %> students</span>
          </div>

          <div class="apro-card">
            <div class="apro-toolbar">
              <input class="apro-input" type="text" placeholder="🔍 Search students..." onkeyup="searchStudents(this.value)">

              <select class="apro-select" onchange="filterForm(this.value)">
                <option value="">All Levels</option>
                <option value="ECD A">ECD A</option><option value="ECD B">ECD B</option>
                <option value="GRADE 1">GRADE 1</option><option value="GRADE 2">GRADE 2</option>
                <option value="GRADE 3">GRADE 3</option><option value="GRADE 4">GRADE 4</option>
                <option value="GRADE 5">GRADE 5</option><option value="GRADE 6">GRADE 6</option>
                <option value="GRADE 7">GRADE 7</option>
                <option disabled>────────</option>
                <option value="Form 1">Form 1</option><option value="Form 2">Form 2</option>
                <option value="Form 3">Form 3</option><option value="Form 4">Form 4</option>
                <option value="Form 5">Form 5</option><option value="Form 6">Form 6</option>
              </select>

              <button class="apro-btn apro-btn-primary" onclick="openAddStudent()">➕ Add Student</button>
              <button class="apro-btn apro-btn-primary" onclick="openImportStudents()">📥 Import Students</button>
              <a href="/admin/students/export" class="apro-btn apro-btn-sm">📤 Export CSV</a>
            </div>

            <div class="apro-table-wrap student-table-wrap">
              <table class="data-table admin-table student-table" id="studentsTable">
                <thead>
                  <tr>
                    <th>ID</th><th>Reg No</th><th>Name</th><th>Form</th><th>Email</th>
                    <th>Phone</th><th>DOB</th><th>Birth / National ID</th><th>Status</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!safeStudents || safeStudents.length === 0) { %>
                    <tr><td colspan="10" class="apro-center-muted">No students found.</td></tr>
                  <% } else { %>
                    <% safeStudents.forEach(s => { %>
                      <tr class="student-directory-row" data-student-id="<%= s.id %>" tabindex="0" title="Click to view student details">
                        <td><%= s.id %></td>
                        <td class="td-strong"><%= s.unique_id %></td>
                        <td><%= s.first_name %> <%= s.last_name %></td>
                        <td><span class="apro-pill"><%= s.form_level %></span></td>
                        <td><%= s.email %></td>
                        <td><%= s.phone || "-" %></td>
                        <td><%= s.date_of_birth ? String(s.date_of_birth).slice(0,10) : "-" %></td>
                        <td><%= s.birth_id_number || "-" %></td>
                        <td>
                          <span class="apro-badge <%= (s.status || 'active') === 'active' ? 'apro-badge-ok' : 'apro-badge-bad' %>">
                            <%= (s.status || "active").toUpperCase() %>
                          </span>
                        </td>
                        <td class="col-actions">
                        
                          <button
                            type="button"
                            class="apro-btn apro-btn-sm"
                            data-student="<%= JSON.stringify(s) %>"
                            onclick="openEditStudent(JSON.parse(this.dataset.student))">
                            ✏️ Edit
                          </button>
                        
                          <form
                            method="POST"
                            action="/admin/students/delete/<%= s.id %>"
                            style="display:inline">
                        
                            <button class="apro-btn apro-btn-danger apro-btn-sm">
                              🗑 Delete
                            </button>
                        
                          </form>
                        
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= TEACHERS ================= -->
        <section id="teachers" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">👨‍🏫 Teacher Management</h2>
              <p class="apro-subtitle">Search, filter, import and manage teaching staff.</p>
            </div>
            <span class="apro-chip"><%= safeTeachersList?.length ?? 0 %> teachers</span>
          </div>

          <div class="apro-card">
            <div class="apro-toolbar">
              <input class="apro-input" type="text" placeholder="🔍 Search teachers..." onkeyup="filterTeachers(this.value)">

              <select class="apro-select" onchange="filterDepartment(this.value)">
                <option value="">All Departments</option>
                <option value="Mathematics">Mathematics</option>
                <option value="Sciences">Sciences</option>
                <option value="Languages">Languages</option>
                <option value="Humanities">Humanities</option>
                <option value="Infancy">Infancy</option>
                <option value="Junior">Junior</option>
                <option value="ICT">ICT</option>
              </select>

              <button class="apro-btn apro-btn-primary" onclick="openAddTeacher()">➕ Add Teacher</button>
              <button class="apro-btn apro-btn-primary" onclick="openImportTeachers()">📥 Import Teachers</button>
              <a href="/admin/teachers/export" class="apro-btn apro-btn-sm">📤 Export CSV</a>
            </div>

            <div class="apro-table-wrap">
              <table class="data-table admin-table teacher-table" id="teachersTable">
                <thead>
                  <tr>
                    <th>Teacher ID</th><th>Name</th><th>Department</th><th>Email</th>
                    <th>ID Number</th><th>Appointment Date</th><th>Status</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!safeTeachersList || safeTeachersList.length === 0) { %>
                    <tr><td colspan="8" class="apro-center-muted">No teachers added yet.</td></tr>
                  <% } else { %>
                    <% safeTeachersList.forEach(t => { %>
                      <tr>
                        <td class="td-strong"><%= t.unique_id %></td>
                        <td><%= t.first_name %> <%= t.last_name %></td>
                        <td><span class="apro-pill"><%= t.department %></span></td>
                        <td><%= t.email %></td>
                        <td><%= t.employee_number || "-" %></td>
                        <td><%= t.date_of_appointment ? String(t.date_of_appointment).slice(0,10) : "-" %></td>
                        <td>
                          <span class="apro-badge <%= (t.status || 'active') === 'active' ? 'apro-badge-ok' : 'apro-badge-bad' %>">
                            <%= (t.status || "active").toUpperCase() %>
                          </span>
                        </td>
                        <td class="col-actions">
                          <button class="apro-btn apro-btn-sm" onclick='openEditTeacher(<%- JSON.stringify(t) %>)'>✏️ Edit</button>
                          <form method="POST" action="/admin/teachers/delete/<%= t.id %>" style="display:inline">
                            <button class="apro-btn apro-btn-danger apro-btn-sm">🗑 Delete</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= CLASSES ================= -->
        <section id="classes" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">📚 Class Management</h2>
              <p class="apro-subtitle">Create classes, assign teachers, students and subjects.</p>
            </div>
            <span class="apro-chip"><%= safeClassesList?.length ?? 0 %> classes</span>
          </div>

          <div class="apro-card">
            <div class="apro-toolbar">
              <button class="apro-btn apro-btn-primary" onclick="openAddClass()">➕ Create Class</button>
              <button class="apro-btn" onclick="openAssignTeacher()">👨‍🏫 Assign Teacher</button>
              <button class="apro-btn" onclick="openAssignStudent()">👨‍🎓 Assign Students</button>
              <button class="apro-btn" onclick="openAssignSubjects()">📘 Assign Subjects</button>
              <button class="apro-btn" onclick="openTeacherModal()">Deassign Teacher</button>
            </div>

            <div class="apro-table-wrap">
              <table class="data-table admin-table classes-table">
                <thead>
                  <tr>
                    <th>Class ID</th><th>Name</th><th>Form Level</th><th>Teacher</th><th>Room</th><th>Students</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!safeClassesList || safeClassesList.length === 0) { %>
                    <tr><td colspan="7" class="apro-center-muted">No classes created yet.</td></tr>
                  <% } else { %>
                    <% safeClassesList.forEach(c => { %>
                      <tr>
                        <td class="td-strong"><%= c.class_code %></td>
                        <td><%= c.name %></td>
                        <td><span class="apro-pill"><%= c.form_level %></span></td>
                        <td><%= c.teachers || "Unassigned" %></td>
                        <td><%= c.room || "-" %></td>
                        <td><span class="apro-pill"><%= c.students %></span></td>
                        <td class="col-actions">
                        
                          <button
                            type="button"
                            class="apro-btn apro-btn-primary apro-btn-sm"
                            onclick="viewClassStudents('<%= c.id %>', '<%= c.name %>')">
                            👨‍🎓 View Students
                          </button>
                        
                          <button
                            class="apro-btn apro-btn-sm"
                            onclick='openEditClass(<%- JSON.stringify(c) %>)'>
                            ✏️ Edit
                          </button>
                        
                          <form
                            method="POST"
                            action="/admin/classes/delete/<%= c.id %>"
                            style="display:inline">
                        
                            <button class="apro-btn apro-btn-danger apro-btn-sm">
                              🗑 Delete
                            </button>
                        
                          </form>
                        
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= SUBJECTS ================= -->
        <section id="subjects" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">📘 Subjects</h2>
              <p class="apro-subtitle">Manage school subjects and updates.</p>
            </div>
            <span class="apro-chip"><%= safeSubjects?.length ?? 0 %> subjects</span>
          </div>

          <div class="apro-card">
            <div class="apro-toolbar">
              <button class="apro-btn apro-btn-primary" onclick="openAddSubject()">➕ Add Subject</button>
            </div>

            <div class="apro-table-wrap">
              <table class="data-table">
                <thead>
                  <tr><th>ID</th><th>Subject Name</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% if (safeSubjects && safeSubjects.length) { %>
                    <% safeSubjects.forEach(s => { %>
                      <tr>
                        <td><%= s.id %></td>
                        <td class="td-strong"><%= s.name %></td>
                        <td class="col-actions">
                          <button class="apro-btn apro-btn-sm" onclick='openEditSubject(<%- JSON.stringify(s) %>)'>✏️</button>
                          <form method="POST" action="/admin/subjects/delete/<%= s.id %>" style="display:inline">
                            <button class="apro-btn apro-btn-danger apro-btn-sm">🗑</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="3" class="apro-center-muted">No subjects added yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= FEES ================= -->
        <section id="fees" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">💰 Fee Management</h2>
              <p class="apro-subtitle">Set fees, record payments and view reports.</p>
            </div>
          </div>

          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">💱 Fee Administration</h3>
            </div>

            <div class="apro-toolbar">
              <button class="apro-btn apro-btn-primary" onclick="openFeeStructure()">💰 Set Fee Structure</button>
              <button class="apro-btn" onclick="openPaymentModal()">💳 Record Payment</button>
              <button class="apro-btn" onclick="openFeeReport()">📊 Fee Reports</button>
            </div>

            <div class="apro-divider"></div>

            <h3 class="apro-section-title">Current Fee Structure</h3>

            <div class="apro-table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Form Level</th>
                    <th>Term Fee</th>
                    <th>Annual Fee</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (safeFeeStructure && safeFeeStructure.length) { %>
                    <% safeFeeStructure.forEach(f => { %>
                      <tr>
                        <td class="td-strong"><%= f.form_level %></td>
                        <td>$<%= f.term_fee %></td>
                        <td>$<%= f.annual_fee %></td>
                        <td>
                          <button class="apro-btn apro-btn-sm" onclick='openEditFee(<%- JSON.stringify(f) %>)'>Edit</button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="4" class="apro-center-muted">No fee structure set yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= LIBRARY ================= -->
        <section id="library" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">🏛️ Library Management</h2>
              <p class="apro-subtitle">Manage physical and digital resources.</p>
            </div>
          </div>

          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">📚 Resource Management</h3>
            </div>

            <div class="apro-toolbar">
              <button class="apro-btn apro-btn-primary" onclick="openAddResource()">➕ Add Book</button>
              <button class="apro-btn" onclick="openAddDigital()">💾 Add Digital Resource</button>
              <button class="apro-btn" onclick="openBorrowManager()">🔄 Manage Borrowing</button>
            </div>

            <div class="apro-toolbar" style="margin-top:10px;">
              <input class="apro-input" type="text" placeholder="🔍 Search resources..." onkeyup="filterLibrary(this.value)" style="max-width:280px;">
            </div>

            <div class="apro-table-wrap" style="margin-top:10px;">
              <table class="data-table admin-table library-table" id="libraryTable">
                <thead>
                  <tr>
                    <th onclick="sortLibrary(0)">ID</th>
                    <th onclick="sortLibrary(1)">Title</th>
                    <th onclick="sortLibrary(2)">Author</th>
                    <th onclick="sortLibrary(3)">Category</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="col-actions">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- DYNAMICALLY LOADED -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ================= NOTICES ================= -->
        <section id="notices" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">📢 Notice Management</h2>
              <p class="apro-subtitle">Create, schedule and manage school notices.</p>
            </div>
          </div>

          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">📝 Create & Manage Notices</h3>
            </div>

            <div class="apro-toolbar">
              <button class="apro-btn apro-btn-primary" onclick="openAddNotice()">📢 Publish Notice</button>
              <button class="apro-btn" onclick="openScheduleNotice()">⏰ Schedule Notice</button>
              <button class="apro-btn" type="button">📄 Notice Templates</button>
            </div>

            <div class="apro-divider"></div>

            <div id="noticesList" class="notice-list">
              <!-- Loaded dynamically -->
            </div>
          </div>
        </section>

        <!-- ================= REPORTS ================= -->
        <section id="reports" class="page-content">
          <div class="apro-head">
            <div>
              <h2 class="apro-title">📊 System Reports</h2>
              <p class="apro-subtitle">Analytics dashboard with KPIs and report breakdowns.</p>
            </div>
          </div>

          <div class="apro-card">
            <div class="apro-toolbar" style="margin-bottom:12px;">
              <button class="apro-btn apro-btn-primary" onclick="loadReport('student')">Student Report</button>
              <button class="apro-btn apro-btn-primary" onclick="loadReport('teacher')">Teacher Report</button>
              <button class="apro-btn apro-btn-primary" onclick="loadReport('financial')">Financial Report</button>
              <button class="apro-btn apro-btn-primary" onclick="loadReport('academic')">Academic Report</button>
            </div>

            <div id="reportKPI" class="apro-stats">
              <!-- Dynamic KPI cards injected here -->
            </div>

            <div id="reportContent" style="margin-top:14px;"></div>
          </div>
        </section>

        <!-- ================= FINANCE ================= -->
        <section id="finance" class="page-content">

          <div class="apro-head">
            <div>
              <h2 class="apro-title">💼 Finance Management</h2>
              <p class="apro-subtitle">Invoices, payments, suppliers, purchases, expenses, payroll and ledger.</p>
            </div>
            <span class="apro-chip">Exports + Tabs</span>
          </div>

          <!-- EXPORTS -->
          <div class="apro-card">
            <div class="apro-card-head">
              <h3 class="apro-card-title">📤 Exports</h3>
              <span class="apro-chip">CSV</span>
            </div>

            <div class="apro-actions">
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/invoices">📤 Export Invoices CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/payments">📤 Export Payments CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/expenses">📤 Export Expenses CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/purchases">📤 Export Purchases CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/ledger">📤 Export Ledger CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/assets">📤 Export Assets CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/suppliers">📤 Export Suppliers CSV</a>
              <a class="apro-btn apro-btn-sm apro-btn-outline" href="/admin/finance/export/beam-camfed">📤 Export BEAM/CAMFED CSV</a>
            </div>
          </div>

          <!-- TAB BUTTONS -->
          <div class="apro-card" style="margin-top:14px;">
            <div class="apro-card-head">
              <h3 class="apro-card-title">📌 Finance Tabs</h3>
              <span class="apro-chip">Switch Views</span>
            </div>

            <div class="apro-fin-tabs">
              <button type="button" class="apro-fin-tabbtn is-active" onclick="showFinanceTab('finance-dashboard')">📊 Dashboard</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-create-invoice')">🧾 Create Invoice</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-invoices')">📄 Invoices</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-debtors')">🧑‍🎓 Debtors</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-beam-camfed')">🎓 BEAM/CAMFED</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-payments')">💳 Payments</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-receipts')">🧾 Receipts</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-student-ledger')">📒 Student Ledger</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-statements')">📑 Statements</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-cashbook')">🏦 Cashbook</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-budgets')">🎯 Budgets</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-audit')">🛡️ Audit Trail</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-suppliers')">🏭 Suppliers</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-purchases')">📦 Purchases</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-expenses')">📉 Expenses</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-payslips')">🧑🏽‍🏫 Payslips</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-ledger')">📘 Ledger</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-employees')">🧑 Employees</button>
              <button type="button" class="apro-fin-tabbtn" onclick="showFinanceTab('finance-assets')">🏢 Assets</button>
            </div>
          </div>

          <!-- DASHBOARD -->
          <div id="finance-dashboard" class="finance-tab active">
            <div class="apro-card" style="margin-top:14px;">
              <div class="apro-card-head">
                <h3 class="apro-card-title">📊 Finance Overview</h3>
                <span class="apro-chip">Summary</span>
              </div>

              <div class="apro-stats apro-stats-3">
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">⬆️</span><span class="apro-label">Total Income</span></div>
                  <div class="apro-value">$<%= safeFinance?.total_income || 0 %></div>
                </div>
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">⬇️</span><span class="apro-label">Total Expenses</span></div>
                  <div class="apro-value">$<%= safeFinance?.total_expenses || 0 %></div>
                </div>
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">🧾</span><span class="apro-label">Net Balance</span></div>
                  <div class="apro-value">$<%= (safeFinance?.total_income || 0) - (safeFinance?.total_expenses || 0) %></div>
                </div>
              </div>
            </div>
          </div>

        <!-- CREATE INVOICE -->
        <div id="finance-create-invoice" class="finance-tab">
          <div class="apro-card" style="margin-top:14px;">
            <div class="apro-card-head">
              <h3 class="apro-card-title">🧾 Create Invoice</h3>
              <span class="apro-chip">Billing</span>
            </div>
        
            <p class="apro-hint" style="margin-top:6px;">
              Create invoices for <b>one student</b>, <b>a level</b>, <b>a class</b>, or the <b>whole school</b>.
              Paid/Balances will use Fees payments (optionally filtered by the date range).
            </p>
        
            <form method="POST" action="/admin/finance/invoices" class="apro-form-grid" id="invoice-form">
              <select name="scope" id="invoiceScope" required onchange="toggleInvoiceScope()">
                <option value="single">Single Student</option>
                <option value="level">Per Level</option>
                <option value="class">Per Class</option>
                <option value="school">Whole School</option>
              </select>
        
              <select name="student_id" id="invoiceStudent" required>
                <option value="">Select Student</option>
                <% if (safeStudents && safeStudents.length) { safeStudents.forEach(s => { %>
                  <option value="<%= s.id %>">
                    <%= s.unique_id %> — <%= s.first_name %> <%= s.last_name %> (<%= s.form_level %>)
                  </option>
                <% }) } %>
              </select>
        
              <select name="form_level" id="invoiceLevel" style="display:none;">
                <option value="">Select Level</option>
                <option value="ECD A">ECD A</option><option value="ECD B">ECD B</option>
                <option value="GRADE 1">GRADE 1</option><option value="GRADE 2">GRADE 2</option>
                <option value="GRADE 3">GRADE 3</option><option value="GRADE 4">GRADE 4</option>
                <option value="GRADE 5">GRADE 5</option><option value="GRADE 6">GRADE 6</option>
                <option value="GRADE 7">GRADE 7</option>
                <option disabled>────────</option>
                <option value="Form 1">Form 1</option><option value="Form 2">Form 2</option>
                <option value="Form 3">Form 3</option><option value="Form 4">Form 4</option>
                <option value="Form 5">Form 5</option><option value="Form 6">Form 6</option>
              </select>
        
              <select name="class_id" id="invoiceClass" style="display:none;">
                <option value="">Select Class</option>
                <% if (safeClasses && safeClasses.length) { safeClasses.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %> (<%= c.form_level %>)</option>
                <% }) } %>
              </select>
        
              <select name="term" required>
                <option value="">Term</option>
                <option value="Term 1">Term 1</option>
                <option value="Term 2">Term 2</option>
                <option value="Term 3">Term 3</option>
              </select>
        
              <input name="year" type="number" placeholder="Year (e.g 2026)" required>
        
              <!-- ✅ Optional date range to compute Paid like Fees Report -->
              <input name="pay_start" type="date" placeholder="Start date (optional)">
              <input name="pay_end" type="date" placeholder="End date (optional)">
        
              <button class="apro-btn apro-btn-primary" type="submit" id="invoiceSubmitBtn">
                💾 Create Invoice(s)
              </button>
            </form>
        
            <div id="invoiceBulkMsg" class="apro-hint" style="display:none;margin-top:10px;"></div>
        
            <p class="apro-hint" style="margin-top:10px;">
              Tip: Amount is pulled automatically from <b>Fee Structure (term fee)</b>.
              Payments shown in invoices come from <b>Fees</b>.
            </p>
          </div>
        </div>
                
        <!-- INVOICES -->
        <div id="finance-invoices" class="finance-tab">
          <div class="apro-card" style="margin-top:14px;">
            <div class="apro-card-head">
              <h3 class="apro-card-title">📄 Student Invoices</h3>
              <span class="apro-chip"><%= safeFinance?.invoices?.length ?? 0 %> records</span>
            </div>
        
            <div class="apro-table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>#</th><th>Student</th><th>Term</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (safeFinance?.invoices?.length) { %>
                    <% safeFinance.invoices.forEach(i => { %>
                      <tr>
                        <td class="td-strong">#<%= i.id %></td>
                        <td>
                          <%= (i.first_name ? i.first_name.trim()[0].toUpperCase() + '.' : '') %>
                          <%= ' ' + (i.last_name || '').trim() %>
                        </td>
        
                        <td>
                          <span class="apro-pill"><%= i.term %> <%= i.year %></span>
                        </td>
        
                        <td>$<%= Number(i.total_amount || 0).toFixed(2) %></td>
                        <td>$<%= Number(i.paid_amount || 0).toFixed(2) %></td>
                        <td class="td-strong">$<%= Number(i.balance || 0).toFixed(2) %></td>
        
                        <td>
                          <span class="apro-badge apro-badge-neutral"><%= i.status || 'UNPAID' %></span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="7" class="apro-center-muted">No invoices found.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- DEBTORS -->
        <div id="finance-debtors" class="finance-tab">
          <div class="apro-card" style="margin-top:14px;">
            <div class="apro-card-head">
              <h3 class="apro-card-title">🧑‍🎓 Debtor List</h3>
              <span class="apro-chip"><span id="debtorsCount">0</span> students</span>
            </div>
        
            <p class="apro-hint" style="margin-top:6px;">
              Shows students with <b>outstanding balances</b> (invoices minus payments). Use the date filter to limit by <b>invoice created date</b>.
            </p>
        
            <div class="apro-form-grid" style="margin-top:8px;">
              <input type="date" id="debtorsFrom" placeholder="From date">
              <input type="date" id="debtorsTo" placeholder="To date">
            
            <select id="debtorsClass">
                <option value="">All Classes</option>
                <% safeClasses.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
            </select>
            
            <select id="debtorsForm">
                <option value="">All Grades</option>
                <option value="ECD A">ECD A</option>
                <option value="ECD B">ECD B</option>
                <option value="GRADE 1">GRADE 1</option>
                <option value="GRADE 2">GRADE 2</option>
                <option value="GRADE 3">GRADE 3</option>
                <option value="GRADE 4">GRADE 4</option>
                <option value="GRADE 5">GRADE 5</option>
                <option value="GRADE 6">GRADE 6</option>
                <option value="GRADE 7">GRADE 7</option>
            </select>
            
              <button type="button" class="apro-btn apro-btn-primary" onclick="loadDebtors()">🔎 Apply Filter</button>
              <button type="button" class="apro-btn apro-btn-outline" onclick="clearDebtorsFilter()">♻️ Clear</button>
              <button type="button" class="apro-btn apro-btn-outline" onclick="exportDebtorsExcel()">📥 Export Excel</button>
            </div>
        
            <div class="apro-hint" style="margin-top:8px;">
              Total outstanding: <b>$<span id="debtorsTotal">0.00</span></b>
            </div>
        
            <div class="apro-table-wrap" style="margin-top:12px;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Level</th>
                    <th>Class</th>
                    <th>Invoiced</th>
                    <th>Paid</th>
                    <th>Balance</th>
                  </tr>
                </thead>
                <tbody id="debtorsBody">
                  <tr><td colspan="6" class="apro-center-muted">Select a date range then click Apply Filter.</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

          <!-- BEAM / CAMFED -->
          <div id="finance-beam-camfed" class="finance-tab">
            <div class="apro-card" style="margin-top:14px;">
              <div class="apro-card-head">
                <h3 class="apro-card-title">🎓 BEAM / CAMFED Support</h3>
                <span class="apro-chip"><%= safeFinance?.beamCamfed?.length ?? 0 %> records</span>
              </div>

              <p class="apro-hint" style="margin-top:6px;">
                Record students whose school fees are supported by <b>BEAM</b>, <b>CAMFED</b>, or another sponsor.
                Paid sponsor amounts are also captured as sponsored fee payments by the backend.
              </p>

              <div class="apro-stats apro-stats-3" style="margin-top:12px;">
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">🎯</span><span class="apro-label">Approved Support</span></div>
                  <div class="apro-value">$<%= Number(safeFinance?.beamCamfedStats?.approved || 0).toFixed(2) %></div>
                </div>
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">✅</span><span class="apro-label">Paid by Sponsor</span></div>
                  <div class="apro-value">$<%= Number(safeFinance?.beamCamfedStats?.paid || 0).toFixed(2) %></div>
                </div>
                <div class="apro-stat">
                  <div class="apro-stat-top"><span class="apro-ico">⏳</span><span class="apro-label">Sponsor Balance</span></div>
                  <div class="apro-value">$<%= Number(safeFinance?.beamCamfedStats?.balance || 0).toFixed(2) %></div>
                </div>
              </div>

              <form method="POST" action="/admin/finance/beam-camfed/add" class="apro-form-grid" style="margin-top:14px;">
                <select name="student_id" required>
                  <option value="">Select Student</option>
                  <% if (safeStudents && safeStudents.length) { safeStudents.forEach(s => { %>
                    <option value="<%= s.id %>">
                      <%= s.unique_id %> — <%= s.first_name %> <%= s.last_name %> (<%= s.form_level || '-' %>)
                    </option>
                  <% }) } %>
                </select>

                <select name="sponsor_type" required>
                  <option value="BEAM">BEAM</option>
                  <option value="CAMFED">CAMFED</option>
                  <option value="DONOR">DONOR</option>
                  <option value="OTHER">OTHER</option>
                </select>

                <input name="approved_amount" type="number" step="0.01" placeholder="Approved Amount" required>
                <input name="paid_amount" type="number" step="0.01" placeholder="Paid Amount" value="0">
                <input name="support_date" type="date" title="Support Date">
                <input name="payment_date" type="date" title="Payment Date">
                <input name="reference" placeholder="Reference / Voucher No.">
                <input name="notes" placeholder="Notes (optional)">

                <button class="apro-btn apro-btn-primary" type="submit">
                  💾 Save BEAM/CAMFED Support
                </button>
              </form>

              <div class="apro-table-wrap" style="margin-top:14px;">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Student</th>
                      <th>Level</th>
                      <th>Sponsor</th>
                      <th>Approved</th>
                      <th>Paid</th>
                      <th>Balance</th>
                      <th>Status</th>
                      <th>Created</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (safeFinance?.beamCamfed?.length) { %>
                      <% safeFinance.beamCamfed.forEach((b, index) => { %>
                        <tr>
                          <td><%= index + 1 %></td>
                          <td>
                            <span class="td-strong"><%= b.unique_id || '-' %></span><br>
                            <%= b.first_name || '' %> <%= b.last_name || '' %>
                          </td>
                          <td><%= b.form_level || '-' %></td>
                          <td><span class="apro-pill"><%= b.sponsor_type || '-' %></span></td>
                          <td>$<%= Number(b.approved_amount || 0).toFixed(2) %></td>
                          <td>$<%= Number(b.paid_amount || 0).toFixed(2) %></td>
                          <td class="td-strong">$<%= Number(b.balance || 0).toFixed(2) %></td>
                          <td><span class="apro-badge apro-badge-neutral"><%= b.status || 'PENDING' %></span></td>
                          <td><%= b.created_at ? String(b.created_at).slice(0,10) : '-' %></td>
                          <td>
                            <form method="POST" action="/admin/finance/beam-camfed/delete/<%= b.id %>" onsubmit="return confirm('Delete this BEAM/CAMFED record?');">
                              <button class="apro-btn apro-btn-sm apro-btn-danger" type="submit">🗑 Delete</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="10" class="apro-center-muted">No BEAM/CAMFED records yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- PAYMENTS -->
          <div id="finance-payments" class="finance-tab">
            <div class="apro-card" style="margin-top:14px;">
              <div class="apro-card-head">
                <h3 class="apro-card-title">💳 Payments</h3>
                <span class="apro-chip"><%= safeFinance?.payments?.length ?? 0 %> payments</span>
              </div>

              <form method="POST" action="/admin/finance/payments" class="apro-form-grid">
                <input name="invoice_id" placeholder="Invoice ID (e.g 12)" required>
                <input name="amount" type="number" step="0.01" placeholder="Amount Paid" required>

                <select name="method">
                  <option>Cash</option><option>Bank</option><option>EcoCash</option><option>Card</option>
                </select>

                <input name="reference" placeholder="Reference (optional)">
                <input type="date" name="date" required>

                <button class="apro-btn apro-btn-primary">💾 Save Payment</button>
              </form>

              <div class="apro-table-wrap" style="margin-top:12px;">
                <table class="data-table">
                  <thead>
                    <tr><th>Invoice</th><th>Amount</th><th>Method</th><th>Reference</th><th>Date</th></tr>
                  </thead>
                  <tbody>
                    <% if (safeFinance?.payments?.length) { safeFinance.payments.forEach(p => { %>
                      <tr>
                        <td class="td-strong">#<%= p.invoice_id %></td>
                        <td>$<%= Number(p.amount || 0).toFixed(2) %></td>
