<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Your existing JS -->
<script src="/script.js?v=5"></script>

<script>
  // -----------------------
  // Active nav sync (desktop + mobile)
  // -----------------------
  function setActiveAdmin(btn){
    document.querySelectorAll('.portal-nav .nav-item').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const text = btn.innerText.trim();
    document.querySelectorAll('.portal-nav .nav-item').forEach(b => {
      if (b.innerText.trim() === text) b.classList.add('active');
    });
  }

  // -----------------------
  // Finance helpers (your original logic preserved)
  // -----------------------
  function showFinanceTab(tabId) {
    document.querySelectorAll('#finance .finance-tab').forEach(t => t.classList.remove('active'));
    const el = document.getElementById(tabId);
    if (el) el.classList.add('active');
  }

  function toggleInvoiceScope() {
    const scope = document.getElementById('invoiceScope')?.value || 'single';
    const studentSel = document.getElementById('invoiceStudent');
    const levelSel = document.getElementById('invoiceLevel');

    if (!studentSel || !levelSel) return;

    if (scope === 'single') {
      studentSel.style.display = '';
      studentSel.required = true;
      levelSel.style.display = 'none';
      levelSel.required = false;
    } else if (scope === 'level') {
      studentSel.style.display = 'none';
      studentSel.required = false;
      levelSel.style.display = '';
      levelSel.required = true;
    } else { // all
      studentSel.style.display = 'none';
      studentSel.required = false;
      levelSel.style.display = 'none';
      levelSel.required = false;
    }
  }
  toggleInvoiceScope();

  (function () {
    const form = document.getElementById('invoice-form');
    if (!form) return;

    const msg = document.getElementById('invoiceBulkMsg');
    const btn = document.getElementById('invoiceSubmitBtn');

    const students = <%- JSON.stringify(safeStudents || []) %>;

    form.addEventListener('submit', async function (e) {
      const scope = document.getElementById('invoiceScope')?.value || 'single';
      return;

      e.preventDefault();

      const term = form.querySelector('[name="term"]').value;
      const year = form.querySelector('[name="year"]').value;
      const total_amount = form.querySelector('[name="total_amount"]').value;
      const level = document.getElementById('invoiceLevel')?.value || '';

      let targets = [];
      if (scope === 'all') {
        targets = students;
      } else if (scope === 'level') {
        targets = students.filter(s => String(s.form_level || '').toLowerCase() === String(level).toLowerCase());
      }

      if (!targets.length) {
        if (msg) {
          msg.style.display = '';
          msg.style.color = '#b45309';
          msg.textContent = 'No students found for the selected scope.';
        }
        return;
      }

      if (btn) btn.disabled = true;
      if (msg) {
        msg.style.display = '';
        msg.style.color = '#555';
        msg.textContent = `Creating invoices... 0/${targets.length}`;
      }

      const postOne = async (student_id) => {
        const body = new URLSearchParams({ student_id, term, year, total_amount });
        const res = await fetch('/admin/finance/invoices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString()
        });
        return res.ok;
      };

      let ok = 0;
      for (let i = 0; i < targets.length; i++) {
        try {
          const success = await postOne(String(targets[i].id));
          if (success) ok++;
        } catch (_) {}

        if (msg) msg.textContent = `Creating invoices... ${i + 1}/${targets.length}`;
      }

      if (msg) {
        msg.style.color = ok === targets.length ? '#166534' : '#b45309';
        msg.textContent = `Done: ${ok}/${targets.length} invoices created. Reloading...`;
      }

      setTimeout(() => {
        window.location.href = '/admin#finance';
        window.location.reload();
      }, 700);
    });
  })();

  (function () {
    const form = document.getElementById('purchase-form');
    if (!form) return;

    form.addEventListener('submit', function () {
      const item = (document.getElementById('pur_item')?.value || '').trim();
      const qty  = (document.getElementById('pur_qty')?.value || '').trim();
      const unit = (document.getElementById('pur_unit')?.value || '').trim();
      const store= (document.getElementById('pur_store')?.value || '').trim();
      const notes= (document.getElementById('pur_notes')?.value || '').trim();

      const parts = [];
      if (item) parts.push(`Item: ${item}`);
      if (qty || unit) parts.push(`Qty: ${qty || '-'} ${unit || ''}`.trim());
      if (store) parts.push(`Store: ${store}`);
      if (notes) parts.push(`Notes: ${notes}`);

      const packed = parts.join(' | ') || notes || item || 'Purchase';
      const desc = document.getElementById('pur_description');
      if (desc) desc.value = packed;
    });
  })();
  

    async function loadStudentForEdit(id) {
      try {
        const res = await fetch(`/admin/students/${id}/json`);
        if (!res.ok) throw new Error("Failed to load student");
    
        const s = await res.json();
        openEditStudent(s);
      } catch (err) {
        alert("Could not open student for editing.");
        console.error(err);
      }
    }

</script>
